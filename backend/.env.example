# Copy this file to ".env" for local development.
# On Render, set these as environment variables in the dashboard instead.

# ---------------------------------------------------------------------------
# LLM (Groq) -- get a free key from https://console.groq.com/keys
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ---------------------------------------------------------------------------
# Embeddings (local, no API key needed)
# ---------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# Chunking / retrieval
# ---------------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
MAX_RELEVANT_DISTANCE=0.9

# ---------------------------------------------------------------------------
# Vector store
# ---------------------------------------------------------------------------
CHROMA_PERSIST_DIR=/app/data/chroma_store
CHROMA_COLLECTION_NAME=pdf_knowledge_base

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
ENVIRONMENT=development
MAX_UPLOAD_MB=50
# Comma-separated list of allowed frontend origins (add your Vercel URL in prod)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_CHAT=15/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_TEST=5/minute
RATE_LIMIT_RESET=5/minute
GROQ_MAX_REQUESTS_PER_MINUTE=25
GROQ_MAX_RETRIES=4
